# Copy this file to .env and add the selected provider's API key there.
LLM_PROVIDER=groq
GROQ_API_KEY=

# Temporary Nemotron experiment: set LLM_PROVIDER=openrouter in .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional settings; these match the defaults in config.py.
# MODEL_NAME remains the Groq model, including during the OpenRouter experiment.
MODEL_NAME=openai/gpt-oss-120b
MAX_SEARCH_RESULTS=5
MAX_PAGES_READ=5
MAX_CHARS_PER_PAGE=1000
MAX_REFINEMENT_ROUNDS=2
REQUEST_TIMEOUT=30
MAX_RETRIES=2
SEARCH_BACKEND=auto
LOG_LEVEL=INFO
